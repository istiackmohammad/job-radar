# Copy to .env. Nothing is sent unless AUTO_SEND=1 and SMTP is set.
AUTO_SEND=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Your Name <you@example.com>
REPLY_TO=you@example.com
DIGEST_TO=you@example.com
CONTACT_EMAIL=you@example.com
CV_PATH=./cv.pdf
MAX_AUTO_EMAILS_PER_DAY=8
COMPANY_COOLDOWN_DAYS=90
MIN_MONTHLY_USD=3000
